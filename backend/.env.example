# Copy this file to ".env" (same folder) and change the values you need.
# Every value is optional: without a .env file the defaults below are used,
# which match a fresh XAMPP install (user "root", no password).

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

DB_NAME=community_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Where the Angular app runs (comma-separated if more than one)
FRONTEND_URLS=http://localhost:4200,http://127.0.0.1:4200
